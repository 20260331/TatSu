+    assert not list(tmp_path.glob('.calc.*.tmp'))
+    assert not (tmp_path / 'calc.old').exists()
+
+    bundle = tatsu.load_bundle(outdir)
+    assert bundle.bundle_id == second.bundle_id
+    result = bundle.parse('hello world')
